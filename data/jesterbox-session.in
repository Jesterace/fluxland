#!/bin/sh

if [ -n "${XDG_CONFIG_HOME:-}" ]; then
	config_home=$XDG_CONFIG_HOME
elif [ -n "${HOME:-}" ]; then
	config_home=$HOME/.config
else
	exec @bindir@/fluxland "$@"
fi

config_dir=$config_home/jesterbox
template_dir=@datadir@/fluxland/jesterbox

mkdir -p "$config_dir" "$config_dir/styles"

seed_config() {
	template=$1
	target=$2

	if [ ! -e "$config_dir/$target" ] && [ -r "$template_dir/$template" ]; then
		cp "$template_dir/$template" "$config_dir/$target"
	fi
}

seed_config jesterbox-init init
seed_config jesterbox-menu menu
seed_config keys keys

export FLUXLAND_CONFIG_DIR="$config_dir"
exec "@bindir@/fluxland" "$@"
